# VeriFact AI - Application Environment Variables

# Backend Configuration
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./verifact.db
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ENVIRONMENT=development

# Optional LLM API Configuration (Fallback Rule Engine active by default)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
